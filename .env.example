# Supabase (cloud database, auth, storage, realtime)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: EAS project ID for Expo Push (cloud notifications)
# EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# DEV ONLY — never ship OpenAI keys in production mobile/web bundles.
# Production must proxy AI through your backend (Supabase Edge Function).
# Without this, Spark bakes ad/news text over your photo locally.
# EXPO_PUBLIC_OPENAI_API_KEY=sk-...

# Optional: Groq free tier for smarter demo chat replies (llama-3.1-8b-instant).
# Get a free key at https://console.groq.com — without it, Spark uses a local reply brain.
# EXPO_PUBLIC_GROQ_API_KEY=gsk_...
