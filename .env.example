# Supabase (cloud database, auth, storage, realtime)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: EAS project ID for Expo Push (cloud notifications)
# EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# Set automatically by npm run build:web:demo (git SHA + UTC time). Shown in Profile → Privacy controls.
# EXPO_PUBLIC_BUILD_ID=abc1234-20260920T120000Z

# DEV ONLY — never ship OpenAI keys in production mobile/web bundles.
# Production must proxy AI through your backend (Supabase Edge Function).
# Without this, Spark bakes ad/news text over your photo locally.
# EXPO_PUBLIC_OPENAI_API_KEY=sk-...

# Optional: Groq free tier for smarter demo chat replies (llama-3.1-8b-instant).
# Get a free key at https://console.groq.com — without it, Spark uses a local reply brain.
# EXPO_PUBLIC_GROQ_API_KEY=gsk_...

# Purchases: demo (default) simulates IAP locally. store enables native billing scaffold.
# EXPO_PUBLIC_PURCHASES_MODE=store
# EXPO_PUBLIC_REVENUECAT_API_KEY=appl_...  # required with store mode + react-native-purchases in native builds

# Staff admin (Profile → Admin control panel). Demo default account: admin@spark.demo (super admin).
# EXPO_PUBLIC_ADMIN_ALLOWLIST=admin@spark.demo,you@yourdomain.com
# EXPO_PUBLIC_ADMIN_SUPERADMINS=admin@spark.demo
# EXPO_PUBLIC_ADMIN_DEMO_PIN=123456
# EXPO_PUBLIC_ADMIN_DEV_OPEN=true
# EXPO_PUBLIC_ADMIN_DISABLE_DEFAULT=true

# Pulse disguise — live headlines (optional). Without keys, Pulse uses BBC/Reuters RSS via CORS proxy.
# EXPO_PUBLIC_NEWS_API_KEY=...           # NewsAPI.org top headlines (world / tech / culture)
# EXPO_PUBLIC_NEWS_RSS_PROXY=https://api.allorigins.win/raw?url={url}  # web CORS proxy for RSS XML
